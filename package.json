{
  "name": "@bndynet/dsh-workspace-monitor",
  "version": "0.2.3",
  "description": "Run project scripts, inspect processes and ports, and stop workspace tasks in DSH.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/dsh-workspace-monitor.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "check:dsh": "node scripts/check-dsh.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run check"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "process",
    "ports",
    "monitor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
